GFN-FF (pprcht/gfnff v0.0.1, bundled in CREST 3.0.2): skip the carbonyl/nitro H-bond term when
the acceptor's single neighbor (C of a free CO, N of a free NO) has no other neighbor. Without
it, abhgfnff_eg3 reads uninitialized indices and segfaults. Same guard as xtb >= 6.6 and gfnff
master. Apply in subprojects/gfnff with patch -p1.

--- a/src/gfnff_engrad.f90	2024-08-02 15:40:11.000000000 -0400
+++ b/src/gfnff_engrad.f90	2026-11-05 10:35:55.842783799 -0500
@@ -124,6 +124,7 @@
     integer  :: i,j,k,l,m,ij,nd3
     integer  :: ati,atj,iat,jat
     integer  :: hbA,hbB
+    integer  :: nbk,nbnbk
     integer  :: lin
     logical  :: ex,require_update
     integer  :: nhb1,nhb2,nxb
@@ -549,17 +550,25 @@
     if (nlist%nhb2 .gt. 0) then
       !$omp parallel do default(none) reduction(+:ehb, g) &
       !$omp shared(topo, nlist, param, n, at, xyz, sqrab, srab) &
-      !$omp private(i, j, k, l, etmp, g5tmp)
+      !$omp private(i, j, k, l, nbk, nbnbk, etmp, g5tmp)
       do i = 1,nlist%nhb2
         j = nlist%hblist2(1,i)
         k = nlist%hblist2(2,i)
         l = nlist%hblist2(3,i)
+        !> The carbonyl/nitro term needs the C/N to have a neighbor besides this O: a free
+        !> CO or NO would leave its torsion list empty and pass unset atom indices to bangl.
+        !> Same guard as xtb >= 6.6 (src/gfnff/gfnff_eg.f90).
+        nbk = topo%nb(1,k)
+        nbnbk = 0
+        if (nbk .ne. 0) nbnbk = topo%nb(20,nbk)
         !Carbonyl case R-C=O...H_A
-        if (at(k) .eq. 8.and.topo%nb(20,k) .eq. 1.and.at(topo%nb(1,k)) .eq. 6) then
+        if (at(k) .eq. 8.and.topo%nb(20,k) .eq. 1.and.at(topo%nb(1,k)) .eq. 6 &
+           & .and.nbnbk .gt. 1) then
           call abhgfnff_eg3(n,j,k,l,at,xyz,topo%qa,sqrab,srab, &
              & etmp,g5tmp,param,topo)
           !Nitro case R-N=O...H_A
-        else if (at(k) .eq. 8.and.topo%nb(20,k) .eq. 1.and.at(topo%nb(1,k)) .eq. 7) then
+        else if (at(k) .eq. 8.and.topo%nb(20,k) .eq. 1.and.at(topo%nb(1,k)) .eq. 7 &
+           & .and.nbnbk .gt. 1) then
           call abhgfnff_eg3(n,j,k,l,at,xyz,topo%qa,sqrab,srab, &
              & etmp,g5tmp,param,topo)
           !N hetero aromat
